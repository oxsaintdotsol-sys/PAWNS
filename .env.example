# ==========================================
# PAWNS Telegram Bot - Environment Variables Template
# ==========================================

# Required: Get from @BotFather on Telegram
BOT_TOKEN="your_bot_token_here"

# Required: MongoDB Connection (MongoDB Atlas URI or Railway MongoDB service)
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.mongodb.net/?appName=Cluster0"
MONGODB_DATABASE="pawnstrading"

# Required: Comma-separated Telegram numeric user IDs of administrators
ADMIN_CHAT_IDS="123456789,987654321"

# Runtime mode: "polling" or "webhook"
RUN_MODE="polling"
LOG_LEVEL="INFO"

# Stable secret used to generate unique referral IDs
REFERRAL_SECRET="generate_a_random_32_character_string_here"
REFERRAL_COMMISSION_PERCENT="10"

# Business & Support Configuration
ABOUT_TEXT="PAWNS provides investment, trading onboarding, and related financial services."
SUPPORT_URL="https://t.me/your_support_username"
TERMS_URL="https://example.com/terms"
INVESTMENT_TERMS_URL="https://example.com/investment-terms"

# Service & Partner links
BINGX_URL="https://bingx.com/invite/ATQ29X/"
PAWNS_CHANNEL_URL="https://t.me/pawns_channel_placeholder"
INVESTOR_PORTAL_BOT_URL="https://t.me/pawns_investor_bot_placeholder"

# Partnered Brokers & Prop Firms
BROKER_1_NAME="Exness"
BROKER_1_URL="https://example.com/exness-partner"
BROKER_2_NAME="HFM (HotForex)"
BROKER_2_URL="https://example.com/hfm-partner"
BROKER_3_NAME="Deriv Forex"
BROKER_3_URL="https://example.com/deriv-partner"

PROP_FIRM_1_NAME="Naira Trader"
PROP_FIRM_1_URL="https://example.com/nairatrader"
PROP_FIRM_2_NAME="Naira Prop"
PROP_FIRM_2_URL="https://www.nairaprop.com/?ref=USER1D63"
PROP_FIRM_3_NAME="Global Dollar Prop"
PROP_FIRM_3_URL="https://example.com/dollarprop"

# Crypto Wallets & Networks for Payments
TRADING_WALLET="0xYourEVMWalletAddressHere"
TRADING_NETWORK="BSC (BEP20)"
INVESTMENT_WALLET="TYourTronWalletAddressHere"
INVESTMENT_NETWORK="Tron (TRC20)"

# Naira Bank Details (Forex services only)
USD_NGN_RATE="1400"
NAIRA_BANK_NAME="Zenith Bank"
NAIRA_ACCOUNT_NUMBER="1234567890"
NAIRA_ACCOUNT_NAME="PAWNS Trading Services"
